# --- required ---------------------------------------------------------------
# Base URL of your InvenTree server (no trailing slash)
INVENTREE_URL=https://inventree.example.com
# API token for a user that can add/change parts, stock, locations and parameters.
# Create one in InvenTree (Account settings > Access tokens) or:
#   curl -u USER:PASSWORD "$INVENTREE_URL/api/user/token/?name=invscan"
INVENTREE_TOKEN=
# PIN the web page asks for. Use something long if the site is reachable from the internet.
SCAN_PIN=

# --- optional: fills in descriptions, photos, datasheets, manufacturers, specs -
# Create an app at https://developer.digikey.com and enable "Product Information v4".
# Without these, a scan still creates the part and stock using just the part number.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Local development only: allow running without a PIN
# INVSCAN_ALLOW_NO_PIN=1
